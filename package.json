{
  "name": "mto-timestretch-player",
  "version": "1.0.0",
  "description": "A focused desktop player for slowing down, tuning, and studying audio.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mto.timestretch",
    "productName": "MTO TimeStretch",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
